set_property IOSTANDARD LVCMOS18 [get_ports {adc_data_pins[17]}]
set_property PACKAGE_PIN U17 [get_ports {adc_data_pins[18]}]
set_property IOSTANDARD LVCMOS18 [get_ports {adc_data_pins[18]}]
