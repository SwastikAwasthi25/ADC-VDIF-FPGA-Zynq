# M3 Red Pitaya STEM_125-14_Z7020_4IN_v1.3 trial ADC+SPI pins
# Reuses four-channel historical candidate mapping; requires timing and
# physical validation before FPGA programming. No LED/PWM/PLL assignments.
set_property PACKAGE_PIN Y17 [get_ports {adc_data_pins[0]}]
set_property IOSTANDARD LVCMOS18 [get_ports {adc_data_pins[0]}]
set_property PACKAGE_PIN Y16 [get_ports {adc_data_pins[1]}]
set_property IOSTANDARD LVCMOS18 [get_ports {adc_data_pins[1]}]
